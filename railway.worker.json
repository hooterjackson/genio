{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm run build:server"
  },
  "deploy": {
    "startCommand": "pnpm run start:worker",
    "restartPolicyType": "ALWAYS",
    "multiRegionConfig": {
      "us-east4-eqdc4a": {
        "numReplicas": 1
      }
    },
    "drainingSeconds": "30"
  }
}
