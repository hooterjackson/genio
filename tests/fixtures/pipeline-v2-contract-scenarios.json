      "candidates": [
        { "id": "a", "violations": [] },
        { "id": "b", "violations": [] },
        { "id": "c", "violations": ["album_cap"] },
        { "id": "d", "violations": ["album_cap"] },
        { "id": "e", "violations": ["album_cap"] },
        { "id": "f", "violations": ["explicit_exclusion"] }
      ],
      "expectedState": "exact",
