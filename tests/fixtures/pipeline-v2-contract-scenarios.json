{
  "schemaVersion": 1,
  "purpose": "Provider-free Pipeline V2 release contracts for intent routing, conservative exact-fill planning, constraint relaxation, and partial-vs-failed terminal semantics.",
  "exactFillCases": [
    {
      "id": "XF-COLD-25",
      "target": 25,
      "selectable": 0,
      "observedAttempts": 0,
      "observedSelectable": 0,
      "minimumPlannedRaw": 60,
      "note": "A cold start uses the conservative 50% prior and includes a five-track selectable reserve."
    },
    {
      "id": "XF-OBSERVED-50",
      "target": 50,
      "selectable": 39,
      "observedAttempts": 50,
      "observedSelectable": 39,
      "minimumPlannedRaw": 24,
      "note": "Planning uses the lower confidence bound, not the optimistic observed 78% point estimate."
    },
    {
      "id": "XF-LOW-YIELD-50",
      "target": 50,
      "selectable": 18,
      "observedAttempts": 50,
      "observedSelectable": 18,
      "minimumPlannedRaw": 135,
      "note": "A low-yield route expands discovery rather than repeatedly asking for target plus a fixed percentage."
    },
    {
      "id": "XF-ALREADY-FULL",
      "target": 100,
      "selectable": 100,
      "observedAttempts": 140,
      "observedSelectable": 100,
      "minimumPlannedRaw": 0,
      "note": "Exact fill stops on selectable catalog matches, never on raw candidate count."
    }
  ],
