{
  "name": "needle-playlist-builder",
  "version": "2.4.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:api": "node --experimental-transform-types server/index.ts",
    "dev:worker": "node --experimental-transform-types server/worker-runner.ts",
    "build": "node scripts/check-release.mjs && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build:server": "tsc -p tsconfig.server.json --noEmit",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:api": "node --experimental-transform-types server/index.ts",
    "start:worker": "node --experimental-transform-types server/worker-runner.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --exclude 'tests/*.integration.test.ts'",
    "test:database:preflight": "node scripts/qa-database-preflight.mjs",
    "test:database": "vitest run --no-file-parallelism tests/*.integration.test.ts",
    "test:watch": "vitest",
    "test:e2e": "node scripts/qa-playwright.mjs",
    "test:e2e:system": "GENIO_SYSTEM_E2E=1 GENIO_SYSTEM_E2E_API_PORT=18788 RAILWAY_API_BASE=http://127.0.0.1:18788 node scripts/qa-playwright.mjs tests/e2e/pipeline-v3-system.spec.ts --project=desktop",
    "test:release": "pnpm run lint && pnpm run build && pnpm run test:coverage && pnpm run qa:scenarios:check && pnpm run test:e2e",
    "benchmark": "node --experimental-transform-types scripts/evaluate-benchmarks.ts",
    "benchmark:v2": "node --experimental-transform-types scripts/evaluate-pipeline-v2-release.ts",
    "benchmark:v3": "node --experimental-transform-types scripts/evaluate-pipeline-v3-benchmark.ts tests/fixtures/pipeline-v3-model-benchmark.json",
    "qa:shadow:v2": "node --experimental-transform-types scripts/evaluate-pipeline-v2-shadow.ts",
    "benchmark:export": "node --experimental-transform-types scripts/export-benchmarks.ts",
    "qa:scenarios:export": "node --experimental-transform-types scripts/export-run-scenarios.ts",
    "qa:failures:export": "node --experimental-transform-types scripts/export-automatic-failure-scenarios.ts",
    "qa:scenarios:check": "vitest run tests/production-search-scenarios.test.ts",
    "qa:policy:check": "vitest run tests/production-search-scenarios.test.ts tests/release-candidate-prompt-corpus.test.ts tests/esoteric-policy-scenarios.test.ts tests/ambiguous-genre-breadth-scenarios.test.ts tests/cost-config.test.ts tests/brief-policy.test.ts tests/similarity-policy.test.ts tests/playlist-sequencing.test.ts tests/playlist-title.test.ts",
    "smoke:apple": "node --experimental-transform-types scripts/apple-publication-smoke.ts",
    "smoke:hosted": "node --experimental-transform-types scripts/hosted-publication-smoke.ts",
    "smoke:manifest:staging": "node --experimental-transform-types scripts/staging-manifest-canary.ts",
    "qa:historical-browser-replay": "node --experimental-transform-types scripts/historical-browser-replay.ts run",
    "release:historical-browser-replay:verify": "node --experimental-transform-types scripts/historical-browser-replay.ts verify",
    "release:historical-browser-replay:produce": "node --experimental-transform-types scripts/historical-browser-replay-release-producer.ts",
    "phase-zero:apple": "node --experimental-transform-types scripts/apple-phase-zero.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "release:check": "node scripts/check-release.mjs",
    "release:check:deploy": "node scripts/check-release.mjs --require-tag",
    "release:check:rc": "node scripts/check-release.mjs --require-exact-tag",
    "release:migration:verify": "node --experimental-transform-types scripts/verify-release-migration-phase.ts",
    "release:phase-evidence:produce": "node --experimental-transform-types scripts/promotion-phase-evidence-producer.ts",
    "release:convergence": "node --experimental-transform-types scripts/verify-release-convergence.ts",
    "release:convergence:produce": "node --experimental-transform-types scripts/release-convergence-producer.ts",
    "release:rollout:intent-canary:produce": "node --experimental-transform-types scripts/public-rollout-intent-canary-producer.ts",
    "release:rollout:evidence:produce": "node --experimental-transform-types scripts/public-rollout-evidence-producer.ts",
    "release:browser:produce": "node --experimental-transform-types scripts/final-custom-domain-browser-producer.ts",
    "release:sites-rollback:capture": "node --experimental-transform-types scripts/sites-production-rollback.ts capture",
    "release:sites-rollback:produce": "node --experimental-transform-types scripts/sites-production-rollback.ts produce",
    "release:sites-rollback:verify": "node --experimental-transform-types scripts/sites-production-rollback.ts verify",
    "release:semantic-review:attest": "node --experimental-transform-types scripts/semantic-ranking-review-producer.ts attest",
    "release:semantic-review:produce": "node --experimental-transform-types scripts/semantic-ranking-review-producer.ts produce",
    "release:rollout:apply": "node --experimental-transform-types scripts/apply-public-rollout-cohort.ts",
    "release:offline-attestation:verify": "node --experimental-transform-types scripts/github-offline-attestation.ts verify",
    "release:offline-attestation:authorize": "node --experimental-transform-types scripts/authorize-offline-release-gate.ts",
    "release:receipt:apple:produce": "node --experimental-transform-types scripts/control-plane-receipt-producer.ts apple",
    "release:receipt:provider:produce": "node --experimental-transform-types scripts/control-plane-receipt-producer.ts provider",
    "release:receipt:qa-budget:produce": "node --experimental-transform-types scripts/control-plane-receipt-producer.ts qa-budget",
    "release:staging-control-plane:produce": "node --experimental-transform-types scripts/staging-control-plane-evidence-producer.ts",
    "release:stable:authorize": "node --experimental-transform-types scripts/authorize-stable-release.ts",
    "release:stable:verify": "node --experimental-transform-types scripts/verify-stable-release.ts",
    "release:stable:dispatch:prepare": "node --experimental-transform-types scripts/prepare-stable-release-dispatch.ts",
    "release:artifact:author": "node --experimental-transform-types scripts/release-artifact-author.ts",
    "release:bootstrap:author": "node --experimental-transform-types scripts/stable-predecessor-author.ts",
    "release:snapshot": "node --experimental-transform-types scripts/release-runtime-snapshot.ts",
    "release:fixtures:check": "vitest run tests/release-fixtures.test.ts tests/release-evidence.test.ts",
    "release:evidence": "node --experimental-transform-types scripts/release-evidence.ts",
    "release:new": "node scripts/prepare-release.mjs",
    "security:dependencies": "pnpm audit --audit-level=low",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "railway": "3.5.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
