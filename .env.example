# Shared local/runtime configuration
NODE_ENV=development
PORT=8788
DATABASE_URL=postgresql://needle:needle@127.0.0.1:5432/needle
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Sites -> Railway gateway. Store these as hosted secrets, never NEXT_PUBLIC_*.
RAILWAY_API_BASE=http://127.0.0.1:8788
GATEWAY_KEY_ID=local-v1
GATEWAY_HMAC_SECRET=replace-with-32-random-bytes
GATEWAY_PREVIOUS_KEY_ID=
GATEWAY_PREVIOUS_HMAC_SECRET=
IP_HASH_SECRET=replace-with-32-random-bytes
OWNER_EMAIL=owner@example.com
# Environment-specific release canaries are authenticated so synthetic runs
# can be excluded from user SLOs without trusting a public request flag.
RELEASE_ENVIRONMENT=staging
RELEASE_CANARY_HMAC_SECRET=replace-with-32-random-bytes
# Railway writes these from the reviewed bridge -> expand -> activate plan.
# Missing/invalid values fail closed to no contract-3/query-plan-5 emission.
RELEASE_DEPLOYMENT_PHASE=bridge
RELEASE_EXPECTED_DATABASE_SCHEMA_VERSION=18

# Anonymous capability sessions
CAPABILITY_PEPPER=replace-with-32-random-bytes
CAPABILITY_PEPPER_VERSION=capability-v2
# During a rotation only, keep the former pepper for verification. New
# tokens/sessions are always hashed with CAPABILITY_PEPPER. Set the deadline
# to the rotation time plus CAPABILITY_SESSION_TTL_DAYS, then remove all three
# previous-pepper variables after it passes.
CAPABILITY_PREVIOUS_PEPPER=
CAPABILITY_PREVIOUS_PEPPER_VERSION=
CAPABILITY_PREVIOUS_PEPPER_EXPIRES_AT=
CAPABILITY_SESSION_TTL_DAYS=90

# Owner-funded OpenAI project
OPENAI_API_KEY=
# Public curated requests use one structured guided preflight followed by the
# bounded fast research profile. Guided answers require no second model call.
# Explicit deep research retains the slower source-frontier workflow.
OPENAI_BRIEF_MODEL=gpt-5.4-mini
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_DEEP_MODEL=gpt-5.6-terra
# Pipeline V2 pinned curated snapshots. When set, these take precedence over
# the legacy FAST/DEEP aliases above for new curated route decisions.
OPENAI_CURATED_LUNA_SNAPSHOT=gpt-5.6-luna
OPENAI_CURATED_TERRA_SNAPSHOT=gpt-5.6-terra
# Pipeline V3 accepts only these release-validated provider model IDs. The
# provider currently exposes managed aliases rather than dated GPT-5.6 IDs;
# every run records that resolution mode and the catalog-validation time.
PIPELINE_V3_BASELINE_MODEL_ID=gpt-5.6-luna
PIPELINE_V3_ESCALATION_MODEL_ID=gpt-5.6-terra
PIPELINE_V3_MODEL_CATALOG_VALIDATED_AT=2026-07-20T00:00:00.000Z
# V2 rollout is sticky by anonymous capability bucket. Owner curated runs are
# canaries only after operations confirms every fresh worker is V2-capable.
PIPELINE_V2_OWNER_CANARY=false
# Public traffic remains on V1 until this percentage advances.
PIPELINE_V2_CURATED_PERCENT=0
# Similarity has a separate relevance benchmark and graduates only after the
# core curated genre/scene and mood cohorts.
PIPELINE_V2_SIMILARITY_PERCENT=0
# Factual/exhaustive V2 has independent claim/frontier benchmark gates. Keep
# both disabled until that benchmark clears; the legacy CANARY name is ignored.
PIPELINE_V2_FACTUAL_OWNER_CANARY=false
PIPELINE_V2_FACTUAL_PERCENT=0
# Retained for backward-compatible deployments; deep research no longer falls
# back to this unsuffixed Sol alias.
OPENAI_MODEL=
OPENAI_BENCHMARK_MODEL=
OPENAI_INPUT_USD_PER_MILLION=5
OPENAI_OUTPUT_USD_PER_MILLION=30
OPENAI_LUNA_INPUT_USD_PER_MILLION=1
OPENAI_LUNA_CACHED_INPUT_USD_PER_MILLION=0.1
OPENAI_LUNA_OUTPUT_USD_PER_MILLION=6
OPENAI_TERRA_INPUT_USD_PER_MILLION=2.5
OPENAI_TERRA_CACHED_INPUT_USD_PER_MILLION=0.25
OPENAI_TERRA_OUTPUT_USD_PER_MILLION=15
OPENAI_GPT_5_4_MINI_INPUT_USD_PER_MILLION=0.75
OPENAI_GPT_5_4_MINI_CACHED_INPUT_USD_PER_MILLION=0.075
OPENAI_GPT_5_4_MINI_OUTPUT_USD_PER_MILLION=4.5
OPENAI_WEB_SEARCH_USD=0.01
AUTO_RUN_COST_LIMIT_USD=5
APP_MONTHLY_COST_LIMIT_USD=50
COST_TIMEZONE=America/Sao_Paulo

# Durable jobs and abuse controls
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=300
WORKER_RENEW_SECONDS=60
WORKER_HEARTBEAT_SECONDS=30
WORKER_STALE_SECONDS=90
WORKER_POLL_MS=1000
# Research conversations reset after this many model turns while DB state,
# source URLs, adapter cursors, and containers remain durable.
RESEARCH_TURNS_PER_SEGMENT=5
RESEARCH_MAX_SEGMENTS_PER_PASS=3
RESEARCH_MAX_GAP_PASSES=6
MAX_GLOBAL_NONTERMINAL_RUNS=10
BRIEF_LIMIT_PER_24H=10
RUN_LIMIT_PER_24H=3
# Feedback is additionally limited to 2/hour and 5/day per anonymous bucket.
FEEDBACK_GLOBAL_DAILY_LIMIT=100
FEEDBACK_STORAGE_LIMIT_BYTES=104857600
RETENTION_DAYS=90
RESULT_REUSE_DAYS=30
FAST_RESEARCH_MAX_WEB_CALLS=5
FAST_RESEARCH_MAX_SYNTHESIS_TOKENS=6000
FAST_RESEARCH_MAX_EXTRACTION_TOKENS=8000
FAST_RESEARCH_SEARCH_CONTEXT=low

# Corpus-first Pipeline V3. Keep the master assignment disabled until schema
# 18, protocol-10 workers, a locked graph snapshot, and the owner canary have
# all been verified. Public engine percentages remain zero during canarying.
PIPELINE_V3_ASSIGNMENT_ENABLED=false
# Query-plan schema 4 binds the active immutable contract revision and requires
# protocol-10 workers. Historical schema-1/2/3 work remains drain-only.
PIPELINE_V3_QUERY_PLAN_SCHEMA_VERSION=6
PIPELINE_V3_PRODUCTION_EVIDENCE_APPROVED=false
PIPELINE_V3_CURATED_HOSTED_EVIDENCE_APPROVED=false
PIPELINE_V3_GENRE_SCENE_EVIDENCE_APPROVED=false
PIPELINE_V3_GEOGRAPHIC_SCOPE_EVIDENCE_APPROVED=false
PIPELINE_V3_FACTUAL_FEASIBILITY_APPROVED=false
# Contract 2 remains a legacy drain/rollback bridge. Contract 3 can be enabled
# globally or first for owner and reggaeton cohorts; all executing lanes must
# receive the same values so their configuration hashes are comparable.
GUIDANCE_CONTRACT_V2_ENABLED=true
GUIDANCE_CONTRACT_V2_OWNER_CANARY=true
GUIDANCE_CONTRACT_V3_ENABLED=false
GUIDANCE_CONTRACT_V3_OWNER_CANARY=false
GUIDANCE_CONTRACT_V3_REGGAETON_ENABLED=false
# Dormant until the schema-21/protocol-13 v2.6 activation gates pass.
GUIDANCE_V5_ENABLED=false
PIPELINE_V3_OWNER_CANARY=false
PIPELINE_V3_OWNER_CANARY_GROUPS=genre_scene
PIPELINE_V3_OWNER_CANARY_MAX_TRACKS=50
PIPELINE_V3_GENRE_SCENE_PERCENT=0
PIPELINE_V3_MOOD_ACTIVITY_PERCENT=0
PIPELINE_V3_SIMILARITY_PERCENT=0
PIPELINE_V3_ARTIST_CATALOGUE_PERCENT=0
PIPELINE_V3_FIXED_CONTAINER_PERCENT=0
PIPELINE_V3_FACTUAL_PERCENT=0
PIPELINE_V3_EXHAUSTIVE_PERCENT=0
PIPELINE_V3_MAX_RAW_CANDIDATES=6000
PIPELINE_V3_MAX_ROUNDS=48
PIPELINE_V3_MAX_TOOL_CALLS=48
PIPELINE_V3_MAX_SEARCH_CALLS=16
PIPELINE_V3_MAX_SYNTHESIS_TOKENS=8000
PIPELINE_V3_MAX_EXTRACTION_TOKENS=12000

# Apple Music owner account. Set either the literal .p8 value or its base64 form.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_MEDIA_ID=
APPLE_MUSICKIT_PRIVATE_KEY=
APPLE_MUSICKIT_PRIVATE_KEY_BASE64=
APPLE_STOREFRONT=us
APPLE_MATCHING_CONCURRENCY=4
APPLE_CATALOG_RECOVERY_TIMEOUT_MS=90000
FAST_MATCH_LOOKUP_TIMEOUT_MS=7000
# 32 random bytes encoded as base64/base64url or 64 hex characters.
APPLE_TOKEN_ENCRYPTION_KEY=
APPLE_TOKEN_ENCRYPTION_KEY_ID=v1
# JSON map of old key IDs to keys, used only while rotating encrypted tokens.
APPLE_TOKEN_DECRYPTION_KEYS_JSON={}
APPLE_SHARE_URL_TIMEOUT_SECONDS=120

# Optional research and owner notifications
MUSICBRAINZ_CONTACT=owner@example.com
# Disabled by default and always disabled when NODE_ENV=production. A token alone
# never enables this adapter.
ENABLE_DISCOGS_ADAPTER=false
DISCOGS_TOKEN=
RESEND_API_KEY=
RESEND_FROM=gênio <alerts@example.com>
ALERT_EMAIL=owner@example.com

# Protected release-tooling identities. These are pins and public-key material,
# not runtime feature flags. Keep them in the isolated release authority or
# the GitHub stable-release environment; do not copy private keys into Railway.
RELEASE_CANDIDATE_IMAGE_REFERENCE=
RELEASE_STAGING_ORIGIN=
RELEASE_PRODUCTION_ORIGIN=https://9enio.com
RELEASE_STAGING_CONTROL_PLANE_KEY_ID=
RELEASE_STAGING_CONTROL_PLANE_KEY_SHA256=
RELEASE_GATE_PRODUCER_KEY_ID=
RELEASE_GATE_PRODUCER_KEY_SHA256=
RELEASE_HISTORICAL_REPLAY_KEY_ID=
RELEASE_HISTORICAL_REPLAY_KEY_SHA256=
RELEASE_SEMANTIC_REVIEWER_KEY_ID=
RELEASE_SEMANTIC_REVIEWER_KEY_SHA256=
RELEASE_SITES_CONTROL_PLANE_KEY_ID=
RELEASE_SITES_CONTROL_PLANE_KEY_SHA256=
RELEASE_CANDIDATE_EVIDENCE_KEY_SHA256=
# These independently protected public-key pins verify the signed finalization
# and stable authorization that commit the canonical semantic baseline
# metadata and all ordered fixture hashes. Baseline-specific pins remain valid
# across normal rotation of the keys used to authorize the next stable release.
RELEASE_SEMANTIC_BASELINE_METADATA_SHA256=
RELEASE_SEMANTIC_BASELINE_STABLE_TAG=
RELEASE_SEMANTIC_BASELINE_RELEASE_KEY_SHA256=
RELEASE_SEMANTIC_BASELINE_STABLE_AUTHORIZER_KEY_ID=
RELEASE_SEMANTIC_BASELINE_STABLE_AUTHORIZER_KEY_SHA256=
# Current stable-release authority. These two keys must never be the same.
RELEASE_VERIFICATION_KEY_SHA256=
RELEASE_STABLE_AUTHORIZER_KEY_ID=
RELEASE_STABLE_AUTHORIZER_KEY_SHA256=
# Public rollout advances are derived from five independently signed sources.
# The intent-canary key must be distinct from the rollout-evidence/release key
# and from every source key; these values are public key IDs/SPKI fingerprints.
RELEASE_PUBLIC_ROLLOUT_EVIDENCE_KEY_SHA256=
RELEASE_PUBLIC_ROLLOUT_INTENT_CANARY_KEY_ID=
RELEASE_PUBLIC_ROLLOUT_INTENT_CANARY_KEY_SHA256=
# Hash of the exact five source-key fingerprints, canary-producer fingerprint,
# rollout-evidence fingerprint, and code-owned fixture registry. Release
# candidate finalization embeds this pin in the immutable image.
RELEASE_PUBLIC_ROLLOUT_INTENT_CANARY_AUTHORITY_POLICY_SHA256=
RELEASE_PUBLIC_ROLLOUT_ASSIGNMENT_SOURCE_KEY_ID=
RELEASE_PUBLIC_ROLLOUT_ASSIGNMENT_SOURCE_KEY_SHA256=
RELEASE_PUBLIC_ROLLOUT_MANIFEST_SOURCE_KEY_ID=
RELEASE_PUBLIC_ROLLOUT_MANIFEST_SOURCE_KEY_SHA256=
RELEASE_PUBLIC_ROLLOUT_APPLE_SOURCE_KEY_ID=
RELEASE_PUBLIC_ROLLOUT_APPLE_SOURCE_KEY_SHA256=
RELEASE_PUBLIC_ROLLOUT_BROWSER_SOURCE_KEY_ID=
RELEASE_PUBLIC_ROLLOUT_BROWSER_SOURCE_KEY_SHA256=
RELEASE_PUBLIC_ROLLOUT_METRICS_SOURCE_KEY_ID=
RELEASE_PUBLIC_ROLLOUT_METRICS_SOURCE_KEY_SHA256=

# Independently signed Apple authority source -> receipt signer.
RELEASE_APPLE_CONTROL_PLANE_SOURCE_ISSUER=
RELEASE_APPLE_CONTROL_PLANE_SOURCE_KEY_ID=
RELEASE_APPLE_CONTROL_PLANE_SOURCE_KEY_SHA256=
RELEASE_APPLE_CONTROL_PLANE_ISSUER=
RELEASE_APPLE_CONTROL_PLANE_KEY_ID=
RELEASE_APPLE_CONTROL_PLANE_KEY_SHA256=

# Independently signed provider-project authority source -> receipt signer.
RELEASE_PROVIDER_CONTROL_PLANE_SOURCE_ISSUER=
RELEASE_PROVIDER_CONTROL_PLANE_SOURCE_KEY_ID=
RELEASE_PROVIDER_CONTROL_PLANE_SOURCE_KEY_SHA256=
RELEASE_PROVIDER_CONTROL_PLANE_ISSUER=
RELEASE_PROVIDER_CONTROL_PLANE_KEY_ID=
RELEASE_PROVIDER_CONTROL_PLANE_KEY_SHA256=

# Independently signed QA-budget ledger source -> receipt signer. Added GitHub
# Actions spend is unavailable to promotion until this source and receipt prove
# a positive capped reservation with enough remaining capacity.
RELEASE_QA_BUDGET_LEDGER_SOURCE_ISSUER=
RELEASE_QA_BUDGET_LEDGER_SOURCE_KEY_ID=
RELEASE_QA_BUDGET_LEDGER_SOURCE_KEY_SHA256=
RELEASE_QA_BUDGET_LEDGER_ISSUER=
RELEASE_QA_BUDGET_LEDGER_KEY_ID=
RELEASE_QA_BUDGET_LEDGER_KEY_SHA256=

# GitHub stable-release environment values/secrets. The workflow also verifies
# the environment, protected main branch, exact tag ruleset, and repository
# immutable-release setting through a separate admin-read control-plane token.
STABLE_TAG_RULESET_ID=
STABLE_RELEASE_CONTROL_PLANE_TOKEN=
RELEASE_VERIFICATION_PUBLIC_KEY_B64URL=
RELEASE_STABLE_AUTHORIZER_PUBLIC_KEY_B64URL=
