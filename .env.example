# Shared local/runtime configuration
NODE_ENV=development
PORT=8788
DATABASE_URL=postgresql://needle:needle@127.0.0.1:5432/needle
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Sites -> Railway gateway. Store these as hosted secrets, never NEXT_PUBLIC_*.
RAILWAY_API_BASE=http://127.0.0.1:8788
GATEWAY_KEY_ID=local-v1
GATEWAY_HMAC_SECRET=replace-with-32-random-bytes
GATEWAY_PREVIOUS_KEY_ID=
GATEWAY_PREVIOUS_HMAC_SECRET=
IP_HASH_SECRET=replace-with-32-random-bytes
OWNER_EMAIL=owner@example.com

# Anonymous capability sessions
CAPABILITY_PEPPER=replace-with-32-random-bytes
CAPABILITY_SESSION_TTL_DAYS=90

# Owner-funded OpenAI project
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BENCHMARK_MODEL=
OPENAI_INPUT_USD_PER_MILLION=5
OPENAI_OUTPUT_USD_PER_MILLION=30
OPENAI_WEB_SEARCH_USD=0.01
AUTO_RUN_COST_LIMIT_USD=5
APP_MONTHLY_COST_LIMIT_USD=50
COST_TIMEZONE=America/Sao_Paulo

# Durable jobs and abuse controls
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=300
WORKER_RENEW_SECONDS=60
WORKER_HEARTBEAT_SECONDS=30
WORKER_STALE_SECONDS=90
WORKER_POLL_MS=1000
MAX_GLOBAL_NONTERMINAL_RUNS=10
BRIEF_LIMIT_PER_24H=10
RUN_LIMIT_PER_24H=3
RETENTION_DAYS=90
RESULT_REUSE_DAYS=30

# Apple Music owner account. Set either the literal .p8 value or its base64 form.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_MEDIA_ID=
APPLE_MUSICKIT_PRIVATE_KEY=
APPLE_MUSICKIT_PRIVATE_KEY_BASE64=
APPLE_STOREFRONT=us
# 32 random bytes encoded as base64/base64url or 64 hex characters.
APPLE_TOKEN_ENCRYPTION_KEY=
APPLE_TOKEN_ENCRYPTION_KEY_ID=v1
# JSON map of old key IDs to keys, used only while rotating encrypted tokens.
APPLE_TOKEN_DECRYPTION_KEYS_JSON={}
APPLE_SHARE_URL_TIMEOUT_SECONDS=120

# Optional research and owner notifications
MUSICBRAINZ_CONTACT=owner@example.com
DISCOGS_TOKEN=
RESEND_API_KEY=
RESEND_FROM=Needle <alerts@example.com>
ALERT_EMAIL=owner@example.com
